* text=auto

# Linux shell and source files must keep LF on every platform.
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.ts   text eol=lf
*.vue  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Native Windows scripts.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets.
*.zip  binary
*.xz   binary
*.whl  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.pdf  binary
*.db   binary
