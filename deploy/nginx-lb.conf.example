# Nginx 反向代理 / 多实例负载均衡示例
#
# 使用前提（详见 README「多实例 / 负载均衡部署」）：
#   - 共享数据库：MySQL / PostgreSQL（不要用 SQLite）
#   - 共享 Redis：REDIS_URL 指向同一个 Redis
#   - 共享上传目录：UPLOAD_DIR 指向 NFS/共享卷（图标、内置 presets）
#   - 所有实例 AUTH_SECRET 一致
#   - 只允许一个实例 RUN_BACKGROUND_TASKS=1，其余实例=0
#
# 放到 /etc/nginx/conf.d/snmp-nms.conf 后 nginx -t && systemctl reload nginx

upstream snmp_nms_backend {
    # 实例地址（按实际部署调整；加权轮询）
    server 127.0.0.1:8001 max_fails=3 fail_timeout=30s;
    server 127.0.0.1:8002 max_fails=3 fail_timeout=30s;
    # 如需会话保持（Redis 共享后验证码已跨实例可用，通常不需要）
    # ip_hash;
    keepalive 32;
}

server {
    listen 80;
    server_name nms.example.com;

    client_max_body_size 20m;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location / {
        proxy_pass http://snmp_nms_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # 健康检查由 Nginx Plus 或外部探活用；开源版可直接访问 /api/health
    location = /api/health {
        proxy_pass http://snmp_nms_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        access_log off;
    }

    # Prometheus 抓取：可对单实例直连 8001/8002，也可经此聚合（不推荐，指标会重复）
    location = /metrics {
        proxy_pass http://snmp_nms_backend;
        proxy_set_header Host $host;
        access_log off;
    }
}
