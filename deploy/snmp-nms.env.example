# 智能运维服务平台 - 环境变量样例
# 复制为 deploy/snmp-nms.env 并按需修改（systemd 会读取）

# ---- Web 登录（协议/端口保存在系统配置，默认 HTTPS）----
# 首次安装默认：HTTPS 443 登录，HTTP 80 仅做 308 跳转；首次启动自动签发 10 年自签证书。
# 如 443 无法绑定，系统会自动回退 HTTP 80，可在「系统配置 -> 登录与安全」重新启用 HTTPS。
# 应急临时强制 HTTP: WEB_FORCE_HTTP=1（不要长期开启）
WEB_FORCE_HTTP=0

# ---- 服务 ----
API_HOST=0.0.0.0
API_PORT=8000
# 启动失败重试次数（进程异常退出由 systemd/Docker 负责再次拉起）
STARTUP_RETRIES=3

# ---- 数据库（默认 SQLite；安装脚本新装时自动安装并改用 PostgreSQL）----
# 安装行为（deploy/install-systemd.sh）：
#   - 新装默认自动安装 PostgreSQL，创建数据库 snmp_nms 与用户 nms，生成随机密码后写入本文件；
#   - 安装或连通性验证失败时，安全回退 SQLite 并打印警告，不会中断安装；
#   - 可通过 --no-postgres 关闭、--with-postgres 在已有环境强制对接（不会迁移 SQLite 数据）。
#   - 离线部署：将系统安装包放到 offline/os-packages/debian/*.deb 或 offline/os-packages/rhel/*.rpm；
#     未包含时不会伪造成功，会提示并回退 SQLite。
# SQLite（默认/回退，零依赖）：
DATABASE_URL=sqlite:////opt/snmp-monitor/data/snmp_monitor.db
# PostgreSQL（安装脚本自动生成随机密码后写入，密码仅含十六进制字符，可安全放进 URL）：
# DATABASE_URL=postgresql+psycopg2://nms:密码@127.0.0.1:5432/snmp_nms
# MySQL（需安装 pymysql，已包含在 requirements.txt；不会被安装脚本自动配置）：
# DATABASE_URL=mysql+pymysql://nms:密码@127.0.0.1:3306/snmp_nms?charset=utf8mb4
# 注意：systemd EnvironmentFile 中 # 后为注释；密码含 # @ : / 等字符时必须 URL 编码
# （例如 # 写成 %23），或直接使用只含字母数字的强密码。
# 非 SQLite 连接池（设备量大时调大）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
# SQLite 写锁等待时间（毫秒）；采集写入较多时避免登录报 database is locked
SQLITE_BUSY_TIMEOUT_MS=30000

# ---- 缓存（默认 Redis；安装脚本新装时自动安装并设置密码）----
# 安装行为：新装默认自动安装 Redis/Valkey（服务名 redis-server / redis / valkey 自动兼容），
#   生成随机密码写入 requirepass 后把地址写入本项；失败时安全回退进程内缓存。
#   Debian/Ubuntu 或 RHEL9 系通常服务名为 redis；AlmaLinux 10 通常为 valkey。
#   离线部署同样使用 offline/os-packages/{debian,rhel} 下的系统包。
# 自动生成示例（密码仅含十六进制字符）：
# REDIS_URL=redis://:密码@127.0.0.1:6379/0
# 留空或不配置时使用进程内缓存（跨进程/多实例场景建议使用 Redis）
CACHE_ENABLED=1
CACHE_TTL_TOPOLOGY=5
CACHE_TTL_DASHBOARD=3
CACHE_TTL_BIGSCREEN=3

# ---- 上传文件（设备自定义图标等）----
UPLOAD_DIR=/opt/snmp-monitor/data/uploads

# ---- 日志（控制台 + 轮转文件，便于排查意外退出）----
LOG_DIR=/opt/snmp-monitor/data/logs
LOG_LEVEL=INFO
LOG_MAX_MB=10
LOG_BACKUP_COUNT=5

# ---- SNMP ----
SNMP_COMMUNITY=public
SNMP_TIMEOUT=3
SNMP_RETRIES=1
COLLECTION_INTERVAL=60

# ---- 告警阈值 ----
CPU_THRESHOLD=80
MEMORY_THRESHOLD=85
TEMPERATURE_THRESHOLD=80
TEMPERATURE_CRITICAL_THRESHOLD=90

# ---- 认证与权限（生产环境务必修改 AUTH_SECRET）----
# 留空时自动生成并持久化到 data/.auth_secret
AUTH_SECRET=
AUTH_TOKEN_HOURS=12
# 默认同源不开放跨域；分域部署时填写逗号分隔的受信任来源
CORS_ORIGINS=
AUTH_DEFAULT_ADMIN=admin
# 留空时首次启动随机生成并写入 data/initial_admin_password.txt
AUTH_DEFAULT_PASSWORD=

# ---- 可观测性 ----
# Prometheus /metrics 鉴权（留空表示公开；设置后抓取需带 Bearer/<token>）
METRICS_TOKEN=
# 本实例标识（多实例部署时用于区分，默认取主机名）
INSTANCE_ID=
# 是否运行采集/网站调度/自动备份/审计清理；多实例时只允许一个实例为 1
RUN_BACKGROUND_TASKS=1

# ---- 未激活试用授权（可选）----
# 未导入商业授权时的内置试用资产上限和有效期
LICENSE_TRIAL_MAX_ASSETS=10
LICENSE_TRIAL_DAYS=30
