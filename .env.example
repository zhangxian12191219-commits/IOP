# =============================================================================
# 复制为 .env 后按需修改
# 至少修改：POSTGRES_PASSWORD、DATABASE_URL 中的密码、AUTH_SECRET、
#           AUTH_DEFAULT_PASSWORD
# =============================================================================
# 【按需】时区
TZ=Asia/Shanghai
# 【按需】宿主机访问端口，默认 HTTPS 443、HTTP 80 跳转
HTTP_PORT=80
HTTPS_PORT=443

# 【按需】应用镜像：未指定仓库时会在本机自动构建
# 发布到镜像仓库后可改成 registry/namespace/snmp-nms:tag
NMS_IMAGE=snmp-nms:1.4.6

# ===== PostgreSQL =====
POSTGRES_DB=snmp_nms
POSTGRES_USER=nms
# 【必改】数据库密码
POSTGRES_PASSWORD=
# 【必改】连接串中的密码必须与 POSTGRES_PASSWORD 一致
DATABASE_URL=

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== 应用安全 =====
# 【必改】登录令牌签名密钥，请使用随机长字符串
# 留空时自动生成并持久化到 data/.auth_secret；多实例部署必须显式设置相同值
AUTH_SECRET=
AUTH_TOKEN_HOURS=12
# 大屏/机房数字孪生页签静默续期 token 的有效期（小时），默认 30 天
AUTH_DISPLAY_TOKEN_HOURS=720
# 【按需】初始管理员账号
AUTH_DEFAULT_ADMIN=admin
# 【必改】初始管理员密码
# 留空时自动生成随机密码，保存到 data/initial_admin_password.txt
AUTH_DEFAULT_PASSWORD=

# ===== 采集参数（按需） =====
COLLECTION_INTERVAL=60
SNMP_TIMEOUT=3
SNMP_RETRIES=1
LOG_LEVEL=INFO

# ===== 未激活试用授权（可选）=====
LICENSE_TRIAL_MAX_ASSETS=10
LICENSE_TRIAL_DAYS=30


# ---- 即时通信 WebRTC ----
# 局域网同一网段可留空，浏览器直接使用 host candidate。
# 跨 VLAN/防火墙或需要稳定穿透时，部署 coturn 后填写：
# WEBRTC_TURN_URLS=turn:192.168.1.10:3478,turns:192.168.1.10:5349
# WEBRTC_TURN_USERNAME=nms
# WEBRTC_TURN_CREDENTIAL=change-me
# WEBRTC_STUN_URLS=stun:192.168.1.10:3478
# WEBRTC_FORCE_RELAY=0
